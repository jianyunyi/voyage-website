# MONGO_URI: MongoDB connection string for user registration.
MONGO_URI="mongodb://localhost:27017/voyagex"

# SERVER_PORT: Express API server port (default 3001).
SERVER_PORT=3001

# ADMIN_KEY: 管理员密钥，用于发布/审核攻略（请求头 x-admin-key）
ADMIN_KEY="your-admin-secret-key"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_AMAP_KEY / VITE_AMAP_SECURITY_JS_CODE: public AMap browser credentials for route planning.
# Use your own values locally; never commit production credentials.
VITE_AMAP_KEY="your-amap-browser-key"
VITE_AMAP_SECURITY_JS_CODE="your-amap-security-js-code"
