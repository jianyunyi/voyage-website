{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx src/server/index.ts",
    "dev:all": "npm run server & npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "tsx --test src/lib/experience/*.test.ts src/lib/idempotentFetch.test.ts src/pages/mapPlannerState.test.ts src/pages/homeFieldNotes.test.tsx src/components/ContributionRailIntro.test.tsx src/server/security/*.test.ts src/remotion/*.test.ts",
    "test:vitest": "vitest run --config vitest.config.ts",
    "render:motion": "remotion render src/remotion/index.ts RouteTerrain public/motion/route-terrain.mp4 --codec=h264 --frames=0-299",
    "render:home-field-notes": "remotion render src/remotion/index.ts HomeFieldNotes public/motion/home-field-notes.mp4 --codec=h264 --frames=0-359"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.3",
    "motion": "^12.23.24",
    "pnpm": "^10.33.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.14.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.31.1",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@remotion/cli": "^4.0.523",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "autoprefixer": "^10.4.21",
    "cors": "^2.8.6",
    "jsdom": "^29.1.1",
    "remotion": "^4.0.523",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.81.0"
  }
}
