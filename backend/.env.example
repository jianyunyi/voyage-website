# VoyageX Backend — Environment Variables

# Server
SERVER_PORT=3001

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=voyagex

# Storage transition
# `mysql` initializes the Gorm schema before the current MongoDB-backed
# handlers start. Keep Mongo configured until those handlers are migrated.
DB_DRIVER=mysql
DB_DSN=voyagex:voyagex_password@tcp(localhost:3306)/voyagex?charset=utf8mb4&parseTime=True&loc=Local
MYSQL_MAX_OPEN_CONNS=10
MYSQL_MAX_IDLE_CONNS=5
# Optional isolated schema used only by MySQL integration tests.
# MYSQL_TEST_DSN=voyagex_test:voyagex_test_password@tcp(localhost:3306)/voyagex_test?charset=utf8mb4&parseTime=True&loc=Local

# Admin seeding (optional — leave empty to skip)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=VoyageX 管理员
ADMIN_KEY=

# Phone encryption (64 hex chars = 32 bytes for AES-256-GCM)
# Generate with: openssl rand -hex 32
PHONE_ENCRYPTION_KEY=

# SMS rate limiting
SMS_PHONE_WINDOW_LIMIT=3
SMS_EMAIL_WINDOW_LIMIT=3
SMS_GLOBAL_HOURLY_BUDGET=500

# Environment
NODE_ENV=development

# Cache & traffic control
CACHE_TTL=30s          # 列表查询缓存有效期
NULL_CACHE_TTL=5s      # 空结果缓存（防穿透）
CACHE_JITTER=3s        # TTL 随机抖动（防雪崩）
RATE_LIMIT_PER_MIN=60  # 每 IP 每分钟最大请求数

# MongoDB connection pool
MONGO_MAX_OPEN_CONNS=10
MONGO_MAX_IDLE_CONNS=5

# CORS — front-end origin for Access-Control-Allow-Origin
# In production: CORS_ORIGIN=https://voyagex.yourdomain.com
# In development leave as * or set http://localhost:3000
CORS_ORIGIN=*
